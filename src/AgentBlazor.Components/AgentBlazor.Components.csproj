<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>AgentBlazor</AssemblyName>
    <PackageId>AgentBlazor</PackageId>
    <Description>Blazor-first agentic UI framework for chat surfaces, deterministic actions, and route-scoped workflow assistance.</Description>
    <PackageTags>blazor;aspnetcore;ai;agents;mudblazor;ui;workflow;llm;openai;agentic</PackageTags>
    <PackageReadmeFile>PACKAGE_README.md</PackageReadmeFile>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <IncludeSymbols>false</IncludeSymbols>
    <TargetsForTfmSpecificBuildOutput>$(TargetsForTfmSpecificBuildOutput);IncludeProjectReferenceBuildOutputs</TargetsForTfmSpecificBuildOutput>
  </PropertyGroup>


  <ItemGroup>
    <InternalsVisibleTo Include="AgentBlazor.Components.Tests" />
    <SupportedPlatform Include="browser" />
  </ItemGroup>

  <ItemGroup>
    <!-- Mirror external dependencies from bundled internal assemblies. -->
    <PackageReference Include="AngleSharp" />
    <PackageReference Include="Azure.AI.OpenAI" />
    <PackageReference Include="Markdig" />
    <PackageReference Include="Microsoft.Agents.AI" />
    <PackageReference Include="Microsoft.Agents.AI.Abstractions" />
    <PackageReference Include="Microsoft.Agents.AI.Hosting" />
    <PackageReference Include="Microsoft.Agents.AI.Hosting.AGUI.AspNetCore" />
    <PackageReference Include="Microsoft.Agents.AI.OpenAI" />
    <PackageReference Include="Microsoft.Agents.AI.Workflows" />
    <PackageReference Include="Microsoft.AspNetCore.Components.Web" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Options" />
    <PackageReference Include="MudBlazor" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\AgentBlazor.Hosting\AgentBlazor.Hosting.csproj" PrivateAssets="all" />
    <ProjectReference Include="..\AgentBlazor.Core\AgentBlazor.Core.csproj" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <None Include="PACKAGE_README.md" Pack="true" PackagePath="\" />
    <None Include="icon.png" Pack="true" PackagePath="\" />
  </ItemGroup>

  <Target Name="IncludeProjectReferenceBuildOutputs" DependsOnTargets="ResolveReferences">
    <ItemGroup>
      <BuildOutputInPackage Include="@(ReferenceCopyLocalPaths->WithMetadataValue('ReferenceSourceTarget', 'ProjectReference'))" />
    </ItemGroup>
  </Target>

  <!--
    Regenerate wwwroot/AgentBlazor.min.css from the Razor SDK's compiled scoped-CSS
    bundle (obj/&lt;tfm&gt;/scopedcss/bundle/AgentBlazor.styles.css) on every build so the
    shipped stylesheet can never drift from the component .razor.css sources again.

    Hooks after BundleScopedCssFiles (which produces the bundle) and before
    GenerateStaticWebAssetsManifest / pack manifest generation, so the regenerated file
    is fingerprinted and packed with fresh content. The script skips the write when the
    content is unchanged, keeping fingerprints and build timestamps stable.

    Run scripts/regenerate-min-css.ps1 manually (and commit the result) after editing a
    .razor.css file. See that script for the full contract.
  -->
  <PropertyGroup>
    <CssGenPsExe Condition="'$(CssGenPsExe)' == '' and '$(OS)' == 'Windows_NT'">powershell.exe</CssGenPsExe>
    <CssGenPsExe Condition="'$(CssGenPsExe)' == ''">pwsh</CssGenPsExe>
  </PropertyGroup>

  <Target Name="RegenerateAgentBlazorMinCss"
          AfterTargets="BundleScopedCssFiles"
          BeforeTargets="GenerateStaticWebAssetsManifest"
          Condition="'$(DesignTimeBuild)' != 'true' and '$(DisableScopedCssBundling)' != 'true' and Exists('$(_ScopedCssOutputPath)')">
    <Exec Command="&quot;$(CssGenPsExe)&quot; -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildThisFileDirectory)..\..\scripts\regenerate-min-css.ps1&quot; -ScopedBundle &quot;$(_ScopedCssOutputPath)&quot; -OutputFile &quot;$(MSBuildProjectDirectory)\wwwroot\AgentBlazor.min.css&quot;" />
  </Target>

</Project>
